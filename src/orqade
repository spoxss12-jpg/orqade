
import { useMemo, useState } from "react";
import "./App.css";

const games = [
  { id: 1, title: "Neon Drift", genre: "Racing", icon: "🏎️", color: "neon", rating: "4.9", players: "12.4K", badge: "TRENDING" },
  { id: 2, title: "Shadow Realm", genre: "Adventure", icon: "⚔️", color: "shadow", rating: "4.8", players: "8.2K", badge: "POPULAR" },
  { id: 3, title: "Cyber Arena", genre: "Action", icon: "🤖", color: "cyber", rating: "4.7", players: "6.8K", badge: "HOT" },
  { id: 4, title: "Block Escape", genre: "Puzzle", icon: "🧊", color: "block", rating: "4.6", players: "5.1K", badge: "" },
  { id: 5, title: "Dragon Valley", genre: "Adventure", icon: "🐉", color: "dragon", rating: "4.9", players: "9.3K", badge: "NEW" },
  { id: 6, title: "Turbo Rush", genre: "Racing", icon: "🏁", color: "turbo", rating: "4.8", players: "7.7K", badge: "" },
  { id: 7, title: "Pixel Raiders", genre: "Action", icon: "👾", color: "pixel", rating: "4.5", players: "3.9K", badge: "" },
